# Python
__pycache__/
*.pyc
.venv/
venv/

# Node / Vite (the frontend)
node_modules/
dist/
build/

# Environment files and secrets
.env
.env.*
# Two env files contain NO secrets and are needed by the deployment:
#   frontend/.env.production -> public Render API URL, read by `vite build` on Vercel
#   frontend/.env.example    -> template for developers (points at localhost)
!frontend/.env.production
!frontend/.env.example

# Generated documents (the research paper PDF is built locally)
*.pdf

